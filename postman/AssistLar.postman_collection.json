    {
      "name": "01 - Jornada principal",
      "description": "Execute esta pasta na ordem. Os scripts criam dados unicos e armazenam os UUIDs automaticamente.",
      "item": [
        {
          "name": "01 - Listar planos e capturar UUIDs",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/planos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Planos respondem 200', () => pm.response.to.have.status(200));",
                  "const planos = pm.response.json();",
                  "const completo = planos.find(plano => plano.codigo === 'COMPLETO');",
                  "const essencial = planos.find(plano => plano.codigo === 'ESSENCIAL');",
                  "pm.test('Planos iniciais existem', () => { pm.expect(completo).to.exist; pm.expect(essencial).to.exist; });",
                  "pm.collectionVariables.set('planoId', completo.id);",
                  "pm.collectionVariables.set('planoEssencialId', essencial.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 - Consultar plano COMPLETO",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/planos/{{planoId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Plano responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Plano e COMPLETO', () => pm.expect(pm.response.json().codigo).to.eql('COMPLETO'));"
                ]
              }
            }
          ]
        },
        {
          "name": "03 - Cadastrar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const identificador = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('emailTeste', `portfolio+${identificador}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Cadastro responde 201', () => pm.response.to.have.status(201));",
                  "const cliente = pm.response.json();",
                  "pm.collectionVariables.set('clienteId', cliente.id);",
                  "pm.test('Cliente inicia ATIVO', () => pm.expect(cliente.status).to.eql('ATIVO'));",
                  "pm.test('Location foi informado', () => pm.expect(pm.response.headers.get('Location')).to.include(cliente.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Portfolio\",\n  \"email\": \"{{emailTeste}}\",\n  \"dataNascimento\": \"1990-05-10\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
          "name": "04 - Consultar cliente",
          "request": {
