    {
      "name": "02 - Cenarios negativos de cliente",
      "item": [
        {
          "name": "Rejeitar cliente nascido hoje",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoje = new Date().toLocaleDateString('en-CA', { timeZone: 'America/Sao_Paulo' });",
                  "pm.collectionVariables.set('dataHoje', hoje);",
                  "pm.collectionVariables.set('emailNegativo', `negativo+${pm.variables.replaceIn('{{$guid}}')}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Menor responde 422', () => pm.response.to.have.status(422));",
                  "pm.test('Erro de idade minima', () => pm.expect(pm.response.json().type).to.eql('/erros/idade-minima-nao-atendida'));",
                  "pm.test('Detail esperado', () => pm.expect(pm.response.json().detail).to.eql('O cliente deve ter pelo menos 18 anos.'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente Hoje\",\n  \"email\": \"{{emailNegativo}}\",\n  \"dataNascimento\": \"{{dataHoje}}\"\n}"
            },
            "url": "{{baseUrl}}/api/clientes"
          }
        },
        {
