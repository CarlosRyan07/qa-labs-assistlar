              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Consulta responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('UUID corresponde ao cadastro', () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('clienteId')));"
                ]
